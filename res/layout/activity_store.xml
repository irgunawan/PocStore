<?xml version="1.0" encoding="utf-8"?>
<!-- Ukuran mengikuti @dimen agar layar 128x160 (radio POC) tidak terpotong. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="insideOverlay"
    android:background="#F5F5F5">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/pad_screen">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="@dimen/title_size"
            android:textStyle="bold"
            android:textColor="#111111"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingBottom="@dimen/gap_title" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_loading"
            android:textSize="@dimen/status_size"
            android:textColor="#6B7280"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingBottom="@dimen/gap_status" />

        <LinearLayout
            android:id="@+id/appList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>